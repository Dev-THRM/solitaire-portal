# ── Database (MySQL) ──────────────────────────────────────────────────────────
# Note: If your password contains special characters like '@', '%' or ':', URL-encode them (e.g. '@' -> '%40')
DATABASE_URL="mysql://username:password@host:3306/database_name"

# ── Authentication ────────────────────────────────────────────────────────────
JWT_SECRET="replace-with-a-strong-random-secret"
JWT_EXPIRES_IN="7d"

# ── Gemini AI (Resume Parsing & Categorization) ───────────────────────────────
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-2.0-flash"
CATEGORIZATION_CONFIDENCE_THRESHOLD="0.65"

# ── SMTP Email Notifications (Optional) ───────────────────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@example.com"
SMTP_PASS="your-app-password"
SMTP_FROM="Solitaire Consultancy <your-email@example.com>"
ADMIN_EMAIL="admin@example.com"

# ── Storage (Optional - for persistent uploads across rolling builds) ────────
# On Hostinger, persistent domain uploads (<domainRoot>/uploads) is auto-detected.
# You can also manually set an absolute path outside the build directory:
# UPLOADS_DIR="/home/u628156753/domains/solitairehumanresources.com/uploads"

# ── Google Sheets Sync (Optional) ─────────────────────────────────────────────
# GOOGLE_SERVICE_ACCOUNT_EMAIL="your-service-account@project.iam.gserviceaccount.com"
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GOOGLE_SHEETS_ID="your-google-sheet-id"
# GOOGLE_SHEETS_TAB="Applications"
