// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ── Jobs ─────────────────────────────────────────────────────────────────────

model Job {
  id           String   @id @default(cuid())
  title         String   @db.VarChar(255)
  location      String   @db.VarChar(255)
  type          JobType
  experienceMin Int?
  experienceMax Int?
  salaryMin     Int?
  salaryMax     Int?
  description   String   @db.Text
  requirements  String   @db.Text
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  applications Application[]

  @@index([isActive])
  @@index([type])
  @@map("jobs")
}

enum JobType {
  FULL_TIME
  PART_TIME
  REMOTE
  CONTRACT
  INTERNSHIP
}

// ── Applications ─────────────────────────────────────────────────────────────

model Application {
  id          String            @id @default(cuid())
  jobId       String
  job         Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)

  firstName    String            @db.VarChar(100)
  lastName     String            @db.VarChar(100)
  email        String            @db.VarChar(255)
  phone        String?           @db.VarChar(20)
  currentCtc   String?           @db.VarChar(100)
  expectedCtc  String?           @db.VarChar(100)
  noticePeriod String?           @db.VarChar(100)
  coverLetter  String            @db.Text
  resumeUrl    String?           @db.VarChar(500)
  status       ApplicationStatus @default(PENDING)

  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  resume      Resume?

  @@index([jobId])
  @@index([email])
  @@index([status])
  @@map("applications")
}

enum ApplicationStatus {
  PENDING
  REVIEWED
  CATEGORIZED
  ACCEPTED
  SWITCHED
  ON_HOLD
  REJECTED
}

// ── Admins ───────────────────────────────────────────────────────────────────

model Admin {
  id        String   @id @default(cuid())
  email     String   @unique @db.VarChar(255)
  password  String   @db.VarChar(255) // bcrypt hash
  name      String   @db.VarChar(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admins")
}

// ── Categories (admin-editable taxonomy) ─────────────────────────────────────

model Category {
  id          String   @id @default(cuid())
  name        String   @unique @db.VarChar(150)
  description String   @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  candidateCategories CandidateCategory[]

  @@map("categories")
}

// ── Resumes (extraction + categorization state) ───────────────────────────────

model Resume {
  id            String   @id @default(cuid())
  applicationId String   @unique
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  rawText              String               @db.LongText
  parsedSections       Json?                // { summary, experience, skills, education }
  extractionStatus     ExtractionStatus     @default(PENDING)
  extractionError      String?              @db.Text

  categorizationStatus CategorizationStatus @default(PENDING)
  categorizationError  String?              @db.Text
  categorizedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  candidateCategories CandidateCategory[]

  @@map("resumes")
}

enum ExtractionStatus {
  PENDING
  DONE
  FAILED
}

enum CategorizationStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

// ── CandidateCategories (LLM + manual overrides) ─────────────────────────────

model CandidateCategory {
  id         String  @id @default(cuid())
  resumeId   String
  resume     Resume  @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  confidence Float         // 0.0 – 1.0
  evidence   String        @db.Text
  source     CategorySource @default(LLM)
  isActive   Boolean       @default(true) // false = admin soft-removed

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([resumeId, categoryId])
  @@index([categoryId])
  @@index([source])
  @@map("candidate_categories")
}

enum CategorySource {
  LLM
  MANUAL
}
